# URLs e chave pública do projeto Supabase. Nunca use service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Runtime: usuário restrito gestao_app, pooler Transaction Mode (6543).
DATABASE_URL=postgresql://gestao_app.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_POOLER:6543/postgres?pgbouncer=true&connection_limit=3&schema=private
# Migrações/bootstrap: usuário administrador, conexão direta ou Session Mode (5432).
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:URL_ENCODED_PASSWORD@YOUR_POOLER:5432/postgres?schema=private
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Guarde fora do repositório. Perder esta chave torna os dados criptografados ilegíveis.
DATA_ENCRYPTION_KEY=
# Somente para demonstração LOCAL com dados fictícios, sem banco; nunca em produção.
DEMO_MODE=false
