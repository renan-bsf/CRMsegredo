generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["private"]
}

enum Role {
  ADMIN
  OPERATOR
  @@schema("private")
}
enum Category {
  LINGERIE
  BEACHWEAR
  WELLNESS
  @@schema("private")
}
enum ProductType {
  SET
  TOP
  BOTTOM
  COSMETIC
  ELECTRONIC
  ACCESSORY
  @@schema("private")
}
enum PaymentMethod {
  PIX
  CASH
  DEBIT
  CREDIT
  TRANSFER
  @@schema("private")
}
enum PaymentStatus {
  PAID
  PENDING
  @@schema("private")
}
enum SaleStatus {
  COMPLETED
  CANCELLED
  @@schema("private")
}
enum MovementType {
  RECEIPT
  SALE
  REVERSAL
  ADJUSTMENT
  @@schema("private")
}
enum ExpenseType {
  OPERATING
  PRO_LABORE
  @@schema("private")
}

model Member {
  id        String @id @db.Uuid
  name      String @db.VarChar(100)
  role      Role @default(OPERATOR)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  sales     Sale[]
  expenses  Expense[]
  movements StockMovement[]
  events    AuditEvent[]
  purchases PurchaseDocument[]
  @@schema("private")
}

model Customer {
  id               String @id @default(uuid()) @db.Uuid
  name             String @db.VarChar(100)
  profileEncrypted String @db.Text
  consentAt        DateTime?
  active           Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sales            Sale[]
  @@index([active, name])
  @@schema("private")
}

model Product {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(120)
  category    Category
  type        ProductType
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  variants    Variant[]
  @@index([active, category])
  @@schema("private")
}

model Variant {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku         String @unique @db.VarChar(50)
  color       String @db.VarChar(50)
  size        String @db.VarChar(30)
  braBand     Int?
  braCup      String? @db.VarChar(3)
  bottomSize  String? @db.VarChar(20)
  power       String? @db.VarChar(60)
  priceCents  Int
  minStock    Int @default(3)
  active      Boolean @default(true)
  batches     Batch[]
  items       SaleItem[]
  purchaseItems PurchaseItem[]
  @@index([productId, active])
  @@schema("private")
}

model Batch {
  id            String @id @default(uuid()) @db.Uuid
  variantId     String @db.Uuid
  variant       Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  code          String @db.VarChar(60)
  expiresAt     DateTime? @db.Date
  quantity      Int
  unitCostCents Int
  receivedAt    DateTime @default(now())
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  allocations   SaleAllocation[]
  @@unique([variantId, code])
  @@index([variantId, expiresAt])
  @@schema("private")
}

model Sale {
  id             String @id @default(uuid()) @db.Uuid
  number         Int @unique @default(autoincrement())
  idempotencyKey String @unique @db.Uuid
  requestHash    String @db.VarChar(64)
  customerId     String? @db.Uuid
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  memberId       String @db.Uuid
  member         Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status         SaleStatus @default(COMPLETED)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus
  subtotalCents  Int
  discountCents  Int @default(0)
  totalCents     Int
  costCents      Int
  createdAt      DateTime @default(now())
  paidAt         DateTime?
  cancelledAt    DateTime?
  items          SaleItem[]
  @@index([createdAt, status])
  @@index([customerId])
  @@index([memberId])
  @@index([status, paymentStatus])
  @@schema("private")
}

model SaleItem {
  id            String @id @default(uuid()) @db.Uuid
  saleId        String @db.Uuid
  sale          Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variantId     String @db.Uuid
  variant       Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  description   String @db.VarChar(240)
  quantity      Int
  unitPriceCents Int
  costCents     Int
  allocations   SaleAllocation[]
  @@index([saleId])
  @@index([variantId])
  @@schema("private")
}

model SaleAllocation {
  id       String @id @default(uuid()) @db.Uuid
  itemId   String @db.Uuid
  item     SaleItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId  String @db.Uuid
  batch    Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity Int
  @@index([itemId])
  @@index([batchId])
  @@schema("private")
}

model StockMovement {
  id        String @id @default(uuid()) @db.Uuid
  batchId   String @db.Uuid
  batch     Batch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  memberId  String @db.Uuid
  member    Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  type      MovementType
  delta     Int
  reason    String @db.VarChar(160)
  createdAt DateTime @default(now())
  @@index([batchId, createdAt])
  @@index([memberId])
  @@schema("private")
}

model Expense {
  id          String @id @default(uuid()) @db.Uuid
  description String @db.VarChar(160)
  type        ExpenseType
  amountCents Int
  occurredAt  DateTime @db.Date
  memberId    String @db.Uuid
  member      Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  voidedAt    DateTime?
  @@index([occurredAt, type])
  @@index([memberId])
  @@schema("private")
}

model AuditEvent {
  id        String @id @default(uuid()) @db.Uuid
  memberId  String @db.Uuid
  member    Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  action    String @db.VarChar(60)
  entityId  String @db.Uuid
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([memberId])
  @@schema("private")
}

enum PurchaseKind {
  ORDER
  INVOICE
  @@schema("private")
}
enum PurchaseStatus {
  REGISTERED
  RECEIVED
  CANCELLED
  @@schema("private")
}
model PurchaseDocument {
  id String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique @db.Uuid
  kind PurchaseKind
  status PurchaseStatus @default(REGISTERED)
  supplierName String @db.VarChar(160)
  supplierTaxId String @db.VarChar(14)
  supplierKey String @db.VarChar(160)
  number String @db.VarChar(40)
  series String @default("") @db.VarChar(10)
  accessKey String? @unique @db.VarChar(44)
  issuedAt DateTime @db.Date
  expectedAt DateTime? @db.Date
  notes String @default("") @db.VarChar(2000)
  totalCents Int
  memberId String @db.Uuid
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sourceOrderId String? @db.Uuid
  sourceOrder PurchaseDocument? @relation("OrderInvoices", fields: [sourceOrderId], references: [id], onDelete: Restrict)
  invoices PurchaseDocument[] @relation("OrderInvoices")
  createdAt DateTime @default(now())
  receivedAt DateTime?
  cancelledAt DateTime?
  cancelReason String? @db.VarChar(300)
  items PurchaseItem[]
  @@unique([kind, supplierKey, number, series])
  @@index([issuedAt, id])
  @@index([sourceOrderId])
  @@index([memberId])
  @@index([kind, status])
  @@schema("private")
}
model PurchaseItem {
  id String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  document PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  variantId String @db.Uuid
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  description String @db.VarChar(240)
  quantity Int
  unitCostCents Int
  lotCode String @db.VarChar(60)
  expiresAt DateTime? @db.Date
  batchId String? @db.Uuid
  batch Batch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  @@unique([documentId, variantId, lotCode])
  @@index([batchId])
  @@index([variantId])
  @@schema("private")
}
